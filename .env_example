QUICKNODERETH_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

QUICKNODE_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
QUICKNODE_10=https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
QUICKNODE_1301=https://arbitrum-sepolia.g.alchemy.com/v2/<ALCHEMY_ID>
QUICKNODE_137=https://polygon-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
QUICKNODE_324=https://mainnet.era.zksync.io
QUICKNODE_42161=https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
QUICKNODE_42220=https://forno.celo.org
QUICKNODE_43114=https://api.avax.network/ext/bc/C/rpc
QUICKNODE_480=https://worldchain-rpc.example.com
