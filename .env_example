# ===============================
# Core throttling / infra
# ===============================
THROTTLE_PER_FIVE_MINS=150
# PROVISION_CONCURRENCY=1

CHATBOT_SNS_ARN=
ROLE_ARN=
HOSTED_ZONE=
ETH_GAS_STATION_INFO_URL=

# ===============================
# Direct RPCs (WEB3_RPC_*)
# ===============================
# Ethereum mainnet
WEB3_RPC_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# Optimism mainnet
WEB3_RPC_10=https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# Sepolia (Ethereum testnet)
WEB3_RPC_11155111=https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_ID>

# Polygon mainnet
WEB3_RPC_137=https://polygon-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# zkSync Era mainnet
WEB3_RPC_324=https://mainnet.era.zksync.io

# Arbitrum One
WEB3_RPC_42161=https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# Arbitrum Sepolia
WEB3_RPC_421613=https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_ID>

# Celo mainnet
WEB3_RPC_42220=https://forno.celo.org

# Avalanche C-Chain
WEB3_RPC_43114=https://api.avax.network/ext/bc/C/rpc

# Celo Alfajores testnet
WEB3_RPC_44787=https://alfajores-forno.celo-testnet.org

# BNB Chain mainnet
WEB3_RPC_56=https://bsc-dataseed.binance.org/

# Polygon Mumbai
WEB3_RPC_80001=https://polygon-mumbai.g.alchemy.com/v2/<ALCHEMY_ID>

# Blast mainnet
WEB3_RPC_81457=https://rpc.blast.io

# Base mainnet
WEB3_RPC_8453=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# ===============================
# UniRPC gateway (serves all chains)
# ===============================
# For ETH-only you can just point this at the same RPC as WEB3_RPC_1
UNIRPC_0=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# ===============================
# Alchemy chain-specific envs
# ===============================
# Use the same <ALCHEMY_KEY> everywhere for easy pasting

ALCHEMY_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
ALCHEMY_10=https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
ALCHEMY_11155111=https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_ID>
ALCHEMY_1301=https://arbitrum-sepolia.g.alchemy.com/v2/<ALCHEMY_ID>
ALCHEMY_137=https://polygon-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
ALCHEMY_324=https://mainnet.era.zksync.io
ALCHEMY_42161=https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
ALCHEMY_8453=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# Query keys (non-RPC, for data/subgraphs)
ALCHEMY_QUERY_KEY=<ALCHEMY_ID>
ALCHEMY_QUERY_KEY_2=<ALCHEMY_ID>

# ===============================
# Infura chain-specific envs (optional)
# ===============================
# Only needed if you actually use Infura fallbacks

INFURA_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
INFURA_10=https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
# we don't care about this
INFURA_11155111=https://sepolia.infura.io/v3/<INFURA_KEY> 
INFURA_137=https://polygon-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
INFURA_42161=https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>
INFURA_42220=https://forno.celo.org
INFURA_43114=https://api.avax.network/ext/bc/C/rpc
INFURA_81457=https://rpc.blast.io
INFURA_8453=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_ID>

# ===============================
# QuickNode-style envs (RPC Gateway)
# ===============================
